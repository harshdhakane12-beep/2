
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

#define SIZE 1024

int main()
{
    int fd;
    char input[SIZE], output[SIZE];

    printf("--- Process 1 Started ---\n");

    while(1)
    {
        printf("\nEnter sentence (exit to quit): ");

        fgets(input, SIZE, stdin);
        input[strcspn(input, "\n")] = '\0';

        fd = open("fifo1", O_WRONLY);
        write(fd, input, strlen(input) + 1);
        close(fd);

        if(strcmp(input, "exit") == 0)
            break;

        fd = open("fifo2", O_RDONLY);

        printf("\nAnalysis Report:\n");

        int n;

        while((n = read(fd, output, SIZE-1)) > 0)
        {
            output[n] = '\0';
            printf("%s", output);
        }

        close(fd);
    }

    printf("Process 1 Terminating\n");

    return 0;
}
